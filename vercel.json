{
  "crons": [
    {
      "path": "/api/cron/enhanced-forecast-sync-cdip",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/enhanced-forecast-sync",
      "schedule": "0 */3 * * *"
    },
    {
      "path": "/api/cron/enhanced-forecast-sync-offset",
      "schedule": "30 1-23/3 * * *"
    },
    {
      "path": "/api/cron/forecasts/refresh?source=marine&maxBeaches=60",
      "schedule": "0 */3 * * *"
    },
    {
      "path": "/api/cron/forecasts/refresh?source=tide&maxBeaches=60",
      "schedule": "15 */6 * * *"
    },
    {
      "path": "/api/cron/forecasts/refresh?source=sun",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/wavecast-scrape",
      "schedule": "0 16 * * 0,2,4"
    },
    {
      "path": "/api/cron/update-user-preferences",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/forecast-alerts",
      "schedule": "15 */3 * * *"
    },
    {
      "path": "/api/monitoring/forecast-health",
      "schedule": "*/30 * * * *"
    }
  ]
}
