{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "project": [
    "app/**/*.{ts,tsx}",
    "actions/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "hooks/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "types/**/*.{ts,tsx}",
    "context/**/*.{ts,tsx}",
    "e2e/**/*.ts",
    "__tests__/**/*.{ts,tsx}",
    "scripts/**/*.{ts,tsx,mjs}",
    "store/**/*.{ts,tsx}",
    "config/**/*.{ts,tsx}",
    "state/**/*.{ts,tsx}"
  ],
  "entry": [
    "app/**/page.tsx",
    "app/**/layout.tsx",
    "app/**/route.ts",
    "app/api/**/*.{ts,tsx}",
    "scripts/**/*.{ts,mjs}"
  ],
  "ignoreDependencies": [
    "server-only",
    "ansi-regex",
    "string-width",
    "strip-ansi"
  ],
  "ignore": [
    "**/__tests__/**",
    "types/**",
    "e2e/**"
  ],
  "webpack": true,
  "eslint": true,
  "typescript": {
    "tsConfigPath": "tsconfig.json"
  },
  "paths": {
    "@/*": [
      "./*"
    ]
  },
  "ignoreBinaries": [
    "supabase",
    "psql",
    "sleep",
    "pkill",
    "codex"
  ]
}
