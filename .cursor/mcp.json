{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "env": {
        "PLAYWRIGHT_STORAGE_STATE": "e2e/.auth/state.json"
      }
    },
    "rapid7": {
      "command": "node",
      "args": [
        "scripts/run-rapid7-mcp.js"
      ],
      "env": {
        "RAPID7_API_KEY": "${RAPID7_API_KEY}"
      }
    },
    "Sentry": {
      "url": "https://mcp.sentry.dev/mcp/quiver-z4/javascript-nextjs"
    }
  }
}