.env.sentry-build-plugin

# Database backups (SECURITY - never commit)
db_backups/
*.sql.backup
*.backup
supabase/remote_*.sql
supabase/backup_*.sql
**/*.dump

# Data exports (generated files)
docs/*.csv
docs/*_surf_spots.json
ios/surf_spots_data.json

