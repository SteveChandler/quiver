# Playwright Test Environment Configuration Template
# Copy this file to .env.playwright and configure for your environment

# =============================================================================
# ENVIRONMENT SELECTION
# =============================================================================
TEST_ENV=local

# =============================================================================
# LOCAL TESTING
# =============================================================================
BASE_URL=http://localhost:3000
TEST_USER_EMAIL=your-test-user@example.com
TEST_USER_PASSWORD=your-test-password

# Local Supabase (default local development instance)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-supabase-anon-key

# =============================================================================
# DEV ENVIRONMENT TESTING
# =============================================================================
# Uncomment these to test on dev environment:
# BASE_URL=https://dev.quiversurf.app
# TEST_USER_EMAIL=your-dev-user@example.com
# TEST_USER_PASSWORD=your-dev-password
# VERCEL_BYPASS_TOKEN=your-vercel-bypass-token

# =============================================================================
# TEST CONFIGURATION
# =============================================================================
SKIP_DATA_TESTS=false
HEADED=false
TEST_TIMEOUT=30000

# =============================================================================
# EMAIL CORE LOOP TESTING
# =============================================================================
# Required for email preference setting E2E tests
# Must match the EMAIL_TOKEN_SECRET in your .env file
EMAIL_TOKEN_SECRET=your-email-token-secret-at-least-32-chars

# =============================================================================
# DEBUGGING
# =============================================================================
DEBUG_AUTH=false
DEBUG_TESTS=false

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
# 1. Copy this file: cp .env.playwright.example .env.playwright
# 2. Update TEST_USER_EMAIL and TEST_USER_PASSWORD with valid credentials
# 3. Ensure the user exists in your local Supabase instance
# 4. Run: npm run test:e2e:setup to generate authentication state
# 5. Run: npm run test:e2e to run all tests
