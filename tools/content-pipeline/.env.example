# Quiver Content Pipeline
# These are read from the project root .env.local automatically.
# Only create this file if you need to override values.

# Required - Supabase connection
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional - Flickr API for additional image sources
# Without this, image search falls back to Wikimedia Commons only
# FLICKR_API_KEY=your-flickr-api-key
