{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "env": {
        "PLAYWRIGHT_STORAGE_STATE": ".auth/user.json",
        "X-Test-Mode": "true"
      }
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--read-only",
        "--project-ref=vawdnbbgawichorsjiwe"
      ]
    },
    "rapid7": {
      "command": "node",
      "args": ["scripts/run-rapid7-mcp.js"],
      "env": {
        "RAPID7_API_KEY": "${RAPID7_API_KEY}"
      }
    }
  }
}
