    "@types/suncalc": "^1.9.2",
    "@vercel/analytics": "1.5.0",
    "@vercel/speed-insights": "1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "date-fns": "4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.5.0",
    "embla-carousel-react": "8.5.1",
    "framer-motion": "^12.19.1",
    "image-conversion": "^2.1.1",
    "input-otp": "1.4.1",
    "lodash": "^4.17.21",
    "lucide-react": "^0.454.0",
