{
  "name": "quiver",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.17",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "yarn": "^1.22.0",
    "npm": "please-use-yarn"
  },
  "scripts": {
    "postinstall": "patch-package && (git config core.hooksPath .githooks || true)",
    "hooks:install": "git config core.hooksPath .githooks",
    "fonts:fetch": "node scripts/fetch-fonts.mjs",
    "clean:next": "node scripts/clean-next.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "build:clean": "yarn clean:next && next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern '**/__tests__/**' --ignore-pattern 'e2e/**' --max-warnings=0",
    "deadcode": "knip --no-progress",
    "lint:tests": "eslint __tests__/ e2e/ scripts/**/__tests__/ --max-warnings=1750",
    "lint:all": "yarn lint && yarn lint:tests",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --disable-warning=DEP0040\" jest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:dev:headed": "TEST_ENV=dev BASE_URL=https://dev.quiversurf.app playwright test --headed",
    "test:e2e:dev": "TEST_ENV=dev BASE_URL=https://dev.quiversurf.app playwright test",
    "test:e2e:dev:ui": "TEST_ENV=dev BASE_URL=https://dev.quiversurf.app playwright test --ui",
    "test:e2e:dev:quick": "TEST_ENV=dev BASE_URL=https://dev.quiversurf.app playwright test --grep @dev",
    "test:e2e:usage": "playwright test --grep @usage",
    "test:e2e:usage:dev": "TEST_ENV=dev BASE_URL=https://dev.quiversurf.app playwright test --grep @usage",
    "test:e2e:prod:readonly:list": "PLAYWRIGHT_PROD_READONLY=true BASE_URL=https://www.quiversurf.app playwright test e2e/prod-readonly --project=guest --project=auth --workers=1 --retries=0 --list",
    "test:e2e:prod:readonly:guest": "PLAYWRIGHT_PROD_READONLY=true BASE_URL=https://www.quiversurf.app playwright test e2e/prod-readonly --project=guest --workers=1 --retries=0",
    "test:e2e:prod:readonly:auth": "PLAYWRIGHT_PROD_READONLY=true BASE_URL=https://www.quiversurf.app playwright test e2e/prod-readonly --project=auth --workers=1 --retries=0",
    "test:e2e:prod:readonly": "PLAYWRIGHT_PROD_READONLY=true BASE_URL=https://www.quiversurf.app playwright test e2e/prod-readonly --project=guest --project=auth --workers=1 --retries=0",
    "e2e:serve": "yarn build:clean && next start -p ${E2E_PORT:-3100}",
    "e2e:snapshot-ref": "tsx e2e/scripts/snapshot-prod-reference.ts",
    "e2e:seed-pool": "tsx e2e/scripts/seed-pool-users.ts",
    "test:e2e:auth:debug": "node -e \"console.log(JSON.stringify(require('./e2e/.auth/state.json'), null, 2))\"",
    "test:e2e:auth:reset": "echo '{\"cookies\":[],\"origins\":[]}' > e2e/.auth/state.json",
    "test:e2e:auth:setup": "playwright test --project=guest --headed",
    "test:e2e:setup": "bash scripts/setup-playwright-local.sh",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:smoke:headed": "playwright test --grep @smoke --headed",
    "test:e2e:smoke:dev": "TEST_ENV=dev BASE_URL=https://dev.quiversurf.app playwright test --grep @smoke",
    "test:e2e:prod-gate": "playwright test e2e/guest-app-download-cta.spec.ts e2e/guest-app-handoff.spec.ts e2e/guest-download.spec.ts e2e/guest-landing-media-budget.spec.ts e2e/guest-landing.spec.ts e2e/guest-service-health.spec.ts e2e/guest-smoke.spec.ts --grep @smoke --project=guest",
    "test:e2e:surfline-parity": "RUN_INFRA_TESTS=true RUN_SURFLINE_PARITY=1 SKIP_AUTH_SETUP=true SKIP_E2E_CLEANUP=true TEST_ENV=dev BASE_URL=https://dev.quiversurf.app playwright test api/surfline-parity.spec.ts --project=auth --workers=1",
    "test:e2e:cleanup": "TEST_ENV=dev tsx e2e/scripts/cleanup-test-data.ts",
    "test:e2e:cleanup:dry-run": "TEST_ENV=dev tsx e2e/scripts/cleanup-test-data.ts --dry-run",
    "test:forecast-consistency": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --disable-warning=DEP0040\" jest --runTestsByPath __tests__/forecast-consistency.test.ts",
    "test:cleanup": "tsx scripts/cleanup-test-data.ts",
    "test:cleanup:dry": "tsx scripts/cleanup-test-data.ts --dry-run --verbose",
    "test:integration": "jest __tests__/integration/ --testTimeout=30000",
    "dead:knip": "knip --no-progress",
    "dead:tsprune": "ts-prune -p tsconfig.json",
    "dead:deps": "depcheck --skip-missing=true",
    "dead:all": "yarn dead:knip && yarn dead:tsprune && yarn dead:deps",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:forecast-gate": "tsx scripts/typecheck-forecast-gate.ts",
    "typecheck:strict-unused": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "buoy:test": "node scripts/test-buoy-setup.mjs",
    "buoy:debug": "node scripts/debug-buoy-sync.mjs",
    "buoy:sync": "node scripts/sync-noaa-buoys.mjs",
    "buoy:sync:local": "node scripts/sync-noaa-buoys.mjs 100",
    "buoy:sync:wide": "node scripts/sync-noaa-buoys.mjs 500",
    "buoy:update-conditions": "node scripts/update-buoy-conditions.mjs",
    "buoy:cleanup-inactive": "node scripts/cleanup-inactive-buoys.mjs",
    "forecast:update": "node scripts/update-forecasts-noaa.mjs",
    "phase0:app-deploy-gate": "tsx scripts/phase0-app-deploy-gate.ts",
    "update:all": "node scripts/update-all-data.mjs",
    "cleanup:old": "node scripts/cleanup-old-data.mjs",
    "cleanup:week": "node scripts/cleanup-old-data.mjs 7",
    "cleanup:month": "node scripts/cleanup-old-data.mjs 30",
    "fix:srid": "node scripts/apply-srid-fix.mjs",
    "db:health": "node scripts/check-database-health.mjs",
    "db:types": "supabase gen types typescript --local 2>/dev/null > types/database.generated.ts",
    "db:types:remote": "supabase gen types typescript --linked 2>/dev/null > types/database.generated.ts",
    "db:reset": "supabase db reset",
    "db:reset:types": "supabase db reset && yarn db:types",
    "db:advisor:rollback": "node scripts/db/rollback-validate-advisor-cleanup.mjs",
    "db:advisor:extension-inventory": "psql \"$POSTGRES_URL_NON_POOLING\" -v ON_ERROR_STOP=1 -f scripts/db/extension-relocation-inventory.sql",
    "db:advisor:extension-apply": "psql \"$POSTGRES_URL_NON_POOLING\" -v ON_ERROR_STOP=1 -f scripts/db/extension-relocation-apply.sql",
    "db:advisor:extension-rollback": "psql \"$POSTGRES_URL_NON_POOLING\" -v ON_ERROR_STOP=1 -f scripts/db/extension-relocation-rollback.sql",
    "seed:prod-mock-users": "tsx scripts/seed-prod-mock-users.ts",
    "seed:reseed-mock:dry": "CONFIRM_TARGET=DEV tsx scripts/reseed-mock-cohort.ts --dry-run",
    "seed:reseed-mock:dry:prod": "CONFIRM_TARGET=PROD tsx scripts/reseed-mock-cohort.ts --dry-run",
    "seed:reseed-mock:verify:dev": "CONFIRM_TARGET=DEV tsx scripts/reseed-mock-cohort.ts --verify",
    "seed:reseed-mock:verify:prod": "CONFIRM_TARGET=PROD tsx scripts/reseed-mock-cohort.ts --verify",
    "seed:reseed-mock:dev": "CONFIRM_TARGET=DEV tsx scripts/reseed-mock-cohort.ts",
    "seed:reseed-mock:prod": "CONFIRM_TARGET=PROD CONFIRM_PROD=YES tsx scripts/reseed-mock-cohort.ts",
    "affinity:compute": "tsx scripts/compute-initial-affinities.ts",
    "seed:npc-content:dev": "CONFIRM_TARGET=DEV RATING_COLS='overall_rating,wave_quality_rating,crowd_density_rating,parking_rating,accessibility_rating' tsx scripts/seed-npc-reviews-and-intel.ts",
    "seed:npc-content:prod": "CONFIRM_TARGET=PROD RATING_COLS='overall_rating,wave_quality_rating,crowd_density_rating,parking_rating,accessibility_rating' tsx scripts/seed-npc-reviews-and-intel.ts",
    "npc:daily": "tsx scripts/npc-daily-activity.ts",
    "npc:migrate": "tsx scripts/migrate-npc-profiles.ts",
    "npc:forecast": "tsx scripts/morning-forecast.ts",
    "npc:health": "tsx scripts/check-template-health.ts",
    "morning-intel": "tsx scripts/morningIntel.ts",
    "generate-daily-intel": "tsx scripts/generate-daily-intel.ts",
    "photos:fetch": "tsx scripts/fetch-beach-photos.ts",
    "photos:find:seo": "tsx scripts/find-beach-photo-candidates.ts",
    "photos:download:seo": "tsx scripts/download-approved-seo-photos.ts",
    "check-mock-users": "tsx -e \"import { createClient } from '@supabase/supabase-js'; import { config } from 'dotenv'; config(); const supabase = createClient(process.env.SUPABASE_URL!, process.env.SUPABASE_SERVICE_ROLE_KEY!); supabase.from('profiles').select('id', { count: 'exact' }).eq('is_mock', true).then(r => console.log(r.count || 0))\"",
    "posthog:import:history": "tsx scripts/import-posthog-history.ts",
    "qa:usage:drift": "tsx scripts/qa/usage-coverage-drift.ts",
    "qa:custom-spot-anchors": "tsx scripts/audit-custom-spot-forecast-anchors.ts",
    "install:requirements": "yarn install --frozen-lockfile",
    "setup": "bash install.sh",
    "fresh-install": "rm -rf node_modules package-lock.json && yarn install --frozen-lockfile",
    "build:analyze": "ANALYZE=true yarn build",
    "lighthouse": "lighthouse http://localhost:3000 --output json --output-path scripts/lighthouseRun.json",
    "lighthouse:ci": "npx -y @lhci/cli@0.15.1 autorun",
    "perf:audit": "yarn build && yarn lighthouse",
    "perf:monitor": "next build && next start & sleep 5 && yarn lighthouse && pkill -f 'next start'",
    "perf:test": "node scripts/performance-test.mjs",
    "seo:keyword-bank": "node --import tsx scripts/seo/keyword-bank.ts",
    "seo:gsc-refresh": "node --import tsx scripts/seo/gsc-refresh.ts",
    "seo:technical-audit": "node --import tsx scripts/seo/technical-audit.ts",
    "seo:metadata-audit": "node --import tsx scripts/seo/metadata-audit.ts",
    "check:comparison-sources": "node --import tsx scripts/check-comparison-sources.ts",
    "seo:forecast-authority-audit": "node --import tsx scripts/seo/forecast-authority-audit.ts",
    "seo:forecast-authority-benchmark": "node --import tsx scripts/seo/forecast-authority-benchmark.ts",
    "seo:enrich": "node --import tsx scripts/seo/enrich.ts",
    "seo:export:vercel": "node --import tsx scripts/seo/export-vercel.ts",
    "seo:export:posthog": "node --import tsx scripts/seo/export-posthog.ts",
    "seo:export:dataforseo": "node --import tsx scripts/seo/export-dataforseo.ts",
    "seo:export:competitors": "node --import tsx scripts/seo/export-competitors.ts",
    "seo:export:aeo": "node --import tsx scripts/seo/export-aeo.ts",
    "seo:store-snapshot": "node --import tsx scripts/seo/store-snapshot.ts",
    "seo:backlink-proxy": "node --import tsx scripts/seo/backlink-proxy.ts",
    "seo:outreach-digest": "node --import tsx scripts/seo/outreach-digest.ts",
    "seo:weekly-report": "node --import tsx scripts/seo/weekly-report.ts",
    "reconcile:revenuecat:report": "node --import tsx scripts/revenuecat-entitlement-reconciliation.ts",
    "seo:recommend": "node --import tsx scripts/seo/recommend.ts",
    "codex:triage-tests": "codex exec \"Analyze failing Playwright tests in @tests and propose a minimal diff; respect existing helpers and fixtures.\"",
    "codex:a11y-pass": "codex exec \"Audit @app and @components for a11y; propose diffs to add labels/roles/keyboard nav, keep public APIs stable.\"",
    "geocode:beaches": "tsx scripts/geocodeBeaches.ts",
    "seed:beaches:dry": "node scripts/seed_beaches_from_csv.mjs --file ./docs/quiver_owner_cams_seed_CA_HI_WA_OR.csv --dry-run",
    "seed:beaches": "node scripts/seed_beaches_from_csv.mjs --file ./docs/quiver_owner_cams_seed_CA_HI_WA_OR.csv",
    "terrain:analyze": "tsx scripts/terrain-analysis.ts",
    "terrain:validate": "tsx scripts/terrain/validate-golden-beaches.ts",
    "regression:shoaling": "tsx scripts/shoaling-regression.ts",
    "dev-note": "node scripts/dev-note.mjs",
    "db:local": "node scripts/db-local-from-snapshot.mjs",
    "db:snapshot": "supabase db dump --linked -f supabase/snapshots/schema.sql && node scripts/db-snapshot-catalog.mjs"
  },
