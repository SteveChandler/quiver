{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "dead:knip": "knip --no-progress",
    "dead:tsprune": "ts-prune -p tsconfig.json",
    "dead:deps": "depcheck --skip-missing=true",
    "dead:all": "npm run dead:knip && npm run dead:tsprune && npm run dead:deps",
    "typecheck:strict-unused": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "buoy:test": "node scripts/test-buoy-setup.mjs",
    "buoy:debug": "node scripts/debug-buoy-sync.mjs",
    "buoy:sync": "node scripts/sync-noaa-buoys.mjs",
    "buoy:sync:local": "node scripts/sync-noaa-buoys.mjs 100",
    "buoy:sync:wide": "node scripts/sync-noaa-buoys.mjs 500",
    "buoy:update-conditions": "node scripts/update-buoy-conditions.mjs",
    "buoy:cleanup-inactive": "node scripts/cleanup-inactive-buoys.mjs",
    "forecast:update": "node scripts/update-forecasts-noaa.mjs",
    "update:all": "node scripts/update-all-data.mjs",
    "cleanup:old": "node scripts/cleanup-old-data.mjs",
    "cleanup:week": "node scripts/cleanup-old-data.mjs 7",
    "cleanup:month": "node scripts/cleanup-old-data.mjs 30",
    "fix:srid": "node scripts/apply-srid-fix.mjs",
    "db:health": "node scripts/check-database-health.mjs",
    "install:requirements": "npm install",
    "setup": "bash install.sh",
    "fresh-install": "rm -rf node_modules package-lock.json && npm install",
    "build:analyze": "ANALYZE=true npm run build",
    "lighthouse": "lighthouse http://localhost:3000 --output json --output-path scripts/lighthouseRun.json",
    "lighthouse:ci": "lhci autorun",
    "perf:audit": "npm run build && npm run lighthouse",
    "perf:monitor": "next build && next start & sleep 5 && npm run lighthouse && pkill -f 'next start'",
    "perf:test": "node scripts/performance-test.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "latest",
