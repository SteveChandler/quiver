{
  "$schema": "https://raw.githubusercontent.com/nicknisi/lighthouse-ci/main/packages/cli/src/schema.json",
  "_comment": "Local development config - relaxed thresholds for dev environment",
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000",
        "http://localhost:3000/discover",
        "http://localhost:3000/map"
      ],
      "numberOfRuns": 1,
      "settings": {
        "formFactor": "mobile",
        "emulatedUserAgent": "Mozilla/5.0 (Linux; Android 11; Pixel 5) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/90.0.4430.91 Mobile Safari/537.36",
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "cpuSlowdownMultiplier": 4
        },
        "screenEmulation": {
          "mobile": true,
          "width": 412,
          "height": 823,
          "deviceScaleFactor": 1.75
        },
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ],
        "skipAudits": ["uses-http2"]
      }
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.5 }],
        "categories:accessibility": ["warn", { "minScore": 0.8 }],
        "categories:best-practices": ["warn", { "minScore": 0.7 }],
        "categories:seo": ["warn", { "minScore": 0.7 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.15 }],
        "target-size": ["warn", { "minScore": 0.7 }],
        "color-contrast": ["warn", {}],
        "image-alt": ["warn", {}],
        "errors-in-console": ["off", {}],
        "unminified-javascript": ["off", {}],
        "unused-javascript": ["off", {}],
        "valid-source-maps": ["off", {}]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
