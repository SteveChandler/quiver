# ===============================================
# QUIVER ENVIRONMENT CONFIGURATION
# ===============================================
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to version control

# ===============================================
# SUPABASE CONFIGURATION
# ===============================================
# Choose ONE set: Local Development OR Production/Staging

# --- LOCAL DEVELOPMENT (Recommended for dev) ---
# Run 'supabase start' to get these values
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_local_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_local_service_role_key_here

# --- PRODUCTION/STAGING ---
# Get from: Supabase Dashboard → Project Settings → API
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_production_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_production_service_role_key_here

# --- SUPABASE ACCESS TOKEN (Required for CLI & MCP) ---
# Personal access token for Supabase Management API
# Used by: Supabase CLI, MCP server (for Claude/Cursor), CI/CD workflows
# Get from: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_your_access_token_here

# ===============================================
# ANDROID PRIVATE TESTER ROSTER (DORMANT)
# ===============================================
# Leave credentials unset until the migration, founder/operator policy
# publication checkpoint, Workspace delegation, key storage, and production
# monitoring checklist are approved.
# Scheduler controls are independent and default off.
ANDROID_TESTER_ROSTER_CRON_ENABLED=false
ANDROID_TESTER_ROSTER_GOOGLE_SYNC_ENABLED=false
# Fixed Google Group key; direct active USER membership is the only automatic
# eligibility source.
# ANDROID_TESTER_ROSTER_GOOGLE_GROUP_KEY=quiver-android-testers@yourdomain.com
# ANDROID_TESTER_ROSTER_GOOGLE_DELEGATED_SUBJECT=directory-reader@yourdomain.com
# ANDROID_TESTER_ROSTER_GOOGLE_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
# ANDROID_TESTER_ROSTER_GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# 32 random bytes encoded as base64. Keep old versions during key rotation.
# ANDROID_TESTER_ROSTER_IDENTITY_ACTIVE_KEY_VERSION=1
# ANDROID_TESTER_ROSTER_IDENTITY_KEY_V1=base64_encoded_32_byte_key

# ===============================================
# COMMUNITY SPOT PHOTOS (DORMANT)
# ===============================================
# Keep both global flags false until the private bucket, migration,
# founder/operator-approved policy copy, admin moderation, retention cron, and
# monitoring are deployed.
COMMUNITY_PHOTOS_READ_ENABLED=false
COMMUNITY_PHOTOS_WRITE_ENABLED=false
# Optional exact authenticated-user UUID canary allowlist.
COMMUNITY_PHOTOS_CANARY_USER_IDS=

# ===============================================
# INSTALL ATTRIBUTION (DORMANT)
# ===============================================
# Enable redemption first, validate it independently, then enable issuance.
# Roll back by disabling issuance, draining active tokens for up to 30 days,
# and only then disabling redemption.
INSTALL_ATTRIBUTION_ISSUANCE_ENABLED=false
INSTALL_ATTRIBUTION_REDEMPTION_ENABLED=false
BEACH_SUBPAGE_INSTALL_CTA_ENABLED=false

# ===============================================
# APPLICATION URLS
# ===============================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BASE_URL=http://localhost:3000

# RevenueCat Web Purchase Link or Funnel base URL (HTTPS production link only).
# Purchase Links receive the signed-in user's Supabase ID at runtime. Funnels
# receive it as the encoded app_user_id query parameter.
# NEXT_PUBLIC_REVENUECAT_WEB_CHECKOUT_URL=https://signup.cat/your-production-link/
# Server-only RevenueCat Secret API key. Keep this out of browser/native code.
# REVENUECAT_SECRET_API_KEY=sk_your_revenuecat_secret_api_key
# Read-only RevenueCat API v2 key for server-side funnel measurement.
# REVENUECAT_V2_SECRET_API_KEY=sk_your_revenuecat_v2_secret_api_key

# ===============================================
# POSTHOG ANALYTICS
# ===============================================
# Project token from PostHog project settings.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_ID=your_posthog_project_id
POSTHOG_HOST=https://us.posthog.com
POSTHOG_PERSONAL_API_KEY=phx_your_posthog_personal_api_key

# ===============================================
# DATAFORSEO SEO/ASO AUTOMATION
# ===============================================
# DataForSEO uses Basic Auth: API login + generated API password.
DATAFORSEO_LOGIN=your_dataforseo_login
DATAFORSEO_PASSWORD=your_dataforseo_api_password
DATAFORSEO_COMPETITOR_KEYWORD_LIMIT=100

# ===============================================
# FIREBASE (Push Notifications)
# ===============================================
# Required for mobile push notifications
# Get from: Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour Firebase Private Key Here\n-----END PRIVATE KEY-----\n"

# Firebase Web Config (Public - Safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key_from_firebase_console

# ===============================================
# EXTERNAL APIS
# ===============================================

# Mapbox (Required for maps)
# Get from: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token

# Stormglass (Weather/Surf Data)
STORMGLASS_API_KEY=your_stormglass_api_key

# Resend (Email Service)
RESEND_API_KEY=re_your_resend_api_key
MAIL_FROM="Quiver <noreply@yourdomain.com>"
MAIL_REPLY_TO="support@yourdomain.com"

# Resend Webhook Signing Secret (for email open/click tracking)
# Get from: Resend Dashboard > Webhooks > Signing Secret
RESEND_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Email Core Loop (One-Click Email Actions)
# Secret for signing email action tokens (min 32 characters)
# Generate with: openssl rand -hex 32
EMAIL_TOKEN_SECRET=your-32-char-secret-here
# From address for email core loop messages
EMAIL_FROM_ADDRESS=surf@quiver.surf

# Openverse (Beach Photos - Optional)
OPENVERSE_API_URL=https://api.openverse.org/v1/images/

# ===============================================
# TESTING CREDENTIALS
# ===============================================
# For E2E tests and development testing
# Create a test user in your Supabase Auth
E2E_USER_EMAIL=test@example.com
E2E_USER_PASSWORD=testpassword123
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=testpassword123

# Test Configuration
# Secret for protecting E2E mutation endpoints
E2E_SECRET=generate_random_secret_here_64_chars
ALLOW_E2E_MUTATIONS_DEV=1

# Test Beach ID (Create a test beach in your database)
TEST_BEACH_ID=00000000-0000-0000-0000-000000000000

# ===============================================
# VERCEL DEPLOYMENT (Optional)
# ===============================================
# Only needed when deploying to Vercel
# These are automatically set by Vercel in production

# Vercel Bypass Token (for accessing preview deployments)
# VERCEL_AUTOMATION_BYPASS_SECRET=your_vercel_bypass_token
# VERCEL_BYPASS_TOKEN=your_vercel_bypass_token

# Cron Job Protection
# Required for cron job authentication (must match Vercel's CRON_SECRET)
# Generate with: openssl rand -hex 32
CRON_SECRET=your_secure_random_token_here

# ===============================================
# ENHANCED FORECAST SYNC CONFIGURATION
# ===============================================
# Controls the background forecast cron job behavior
# See docs/FORECAST_CRON_ARCHITECTURE.md for details

# Maximum beaches to update per cron run (default: 45)
# Tuned to stay under Vercel's 5-minute timeout
FORECAST_MAX_BEACHES_PER_RUN=45

# Number of beaches processed per batch (default: 3)
FORECAST_BATCH_SIZE=3

# Delay between batches in milliseconds (default: 2000)
# Prevents API rate limiting
FORECAST_BATCH_DELAY_MS=2000

# Enable verbose per-timepoint logging for debugging (default: false)
# Warning: Increases log volume significantly
FORECAST_VERBOSE_LOGS=false

# Apply active temporary face-height feedback calibration candidates (default: false)
FEEDBACK_HEIGHT_CALIBRATION_ENABLED=false

# Master trusted human-forecaster kill switch. Explicit false disables private
# reads, writes, and canary serving even when the canary flag remains enabled.
TRUSTED_FORECAST_ADJUSTMENTS_ENABLED=true

# Serve private trusted adjustments only to the exact server-side canary
# allowlist. Both flags must be true; keep this false outside the canary.
TRUSTED_FORECAST_CANARY_SERVING_ENABLED=false
TRUSTED_FORECAST_CANARY_USER_IDS=

# ===============================================
# SEO & ANALYTICS (Optional)
# ===============================================
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_verification_code

# ===============================================
# MOBILE APP (iOS/Android)
# ===============================================
# Only needed for mobile app builds
APPLE_TEAM_ID=your_apple_team_id
APPLE_APP_BUNDLE_ID=app.quiversurf.mobile
ANDROID_SHA256_FINGERPRINTS=your_android_sha256_fingerprint

# Google Sign-In (Native OAuth for Capacitor apps)
# The OAuth 2.0 Web Client ID from Google Cloud Console.
# Required for native Google Sign-In on iOS/Android via @capgo/capacitor-social-login.
# Get from: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs (Web type)
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id

# iOS OAuth 2.0 Client ID (iOS type) from Google Cloud Console.
# Required for native Google Sign-In on iOS. Falls back to WEB_CLIENT_ID if not set.
# Get from: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs (iOS type)
NEXT_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id

# Apple Sign-In (Services ID for Sign In with Apple)
# Required for native Apple Sign-In on iOS via Capacitor.
# This is the Services ID (not App ID) from Apple Developer Console.
NEXT_PUBLIC_APPLE_CLIENT_ID=app.quiversurf.mobile.web
# Server-only allowlist for Apple recovery token audiences (comma-separated).
APPLE_RECOVERY_AUDIENCES=app.quiversurf.mobile,app.quiversurf.mobile.web
# Keep false until the migration, Auth config, security review, and rollback drill pass.
APPLE_IDENTITY_RECOVERY_ENABLED=false

# ===============================================
# ML SERVICE CONFIGURATION
# ===============================================
# ===============================================
# ADVANCED CONFIGURATION
# ===============================================

# Database (Direct Connection - Rarely Needed)
# Only use if you need direct Postgres access
# POSTGRES_URL=postgres://user:password@host:5432/database
# POSTGRES_HOST=db.your-project.supabase.co
# POSTGRES_DATABASE=postgres
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_postgres_password

# Product Configuration
RATING_COLS="overall_rating,wave_quality_rating,crowd_density_rating,parking_rating,accessibility_rating"

# ===============================================
# QUICK START GUIDE
# ===============================================
# 1. Copy this file: cp .env.example .env.local
# 2. Start Supabase: supabase start
# 3. Get local keys: supabase status
# 4. Fill in NEXT_PUBLIC_SUPABASE_URL and keys
# 5. Create Firebase project (for push notifications)
# 6. Add Mapbox token (for maps)
# 7. Start dev server: yarn dev
#
# For Claude/Cursor MCP integration:
# 8. Get access token: https://supabase.com/dashboard/account/tokens
# 9. Add SUPABASE_ACCESS_TOKEN to .env.local
#
# For detailed setup instructions, see:
# docs/SUPABASE_GUIDE.md
# docs/SETUP.md
