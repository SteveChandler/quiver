# ===============================================
# QUIVER ENVIRONMENT CONFIGURATION
# ===============================================
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to version control

# ===============================================
# SUPABASE CONFIGURATION
# ===============================================
# Choose ONE set: Local Development OR Production/Staging

# --- LOCAL DEVELOPMENT (Recommended for dev) ---
# Run 'supabase start' to get these values
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_local_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_local_service_role_key_here

# --- PRODUCTION/STAGING ---
# Get from: Supabase Dashboard → Project Settings → API
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_production_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_production_service_role_key_here

# ===============================================
# APPLICATION URLS
# ===============================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BASE_URL=http://localhost:3000

# ===============================================
# FIREBASE (Push Notifications)
# ===============================================
# Required for mobile push notifications
# Get from: Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour Firebase Private Key Here\n-----END PRIVATE KEY-----\n"

# Firebase Web Config (Public - Safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ===============================================
# EXTERNAL APIS
# ===============================================

# Mapbox (Required for maps)
# Get from: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token

# Stormglass (Weather/Surf Data)
STORMGLASS_API_KEY=your_stormglass_api_key

# Resend (Email Service)
RESEND_API_KEY=re_your_resend_api_key
MAIL_FROM="Quiver <noreply@yourdomain.com>"
MAIL_REPLY_TO="support@yourdomain.com"

# Openverse (Beach Photos - Optional)
OPENVERSE_API_URL=https://api.openverse.org/v1/images/

# ===============================================
# TESTING CREDENTIALS
# ===============================================
# For E2E tests and development testing
# Create a test user in your Supabase Auth
E2E_USER_EMAIL=test@example.com
E2E_USER_PASSWORD=testpassword123
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=testpassword123

# Test Configuration
# Secret for protecting E2E mutation endpoints
E2E_SECRET=generate_random_secret_here_64_chars
ALLOW_E2E_MUTATIONS_DEV=1

# Test Beach ID (Create a test beach in your database)
TEST_BEACH_ID=00000000-0000-0000-0000-000000000000

# ===============================================
# VERCEL DEPLOYMENT (Optional)
# ===============================================
# Only needed when deploying to Vercel
# These are automatically set by Vercel in production

# Vercel Bypass Token (for accessing preview deployments)
# VERCEL_AUTOMATION_BYPASS_SECRET=your_vercel_bypass_token
# VERCEL_BYPASS_TOKEN=your_vercel_bypass_token

# Cron Job Protection
# CRON_SECRET_TOKEN=generate_random_secret_for_cron_jobs

# ===============================================
# SEO & ANALYTICS (Optional)
# ===============================================
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_verification_code

# ===============================================
# MOBILE APP (iOS/Android)
# ===============================================
# Only needed for mobile app builds
APPLE_TEAM_ID=your_apple_team_id
APPLE_APP_BUNDLE_ID=app.quiversurf.mobile

# ===============================================
# ADVANCED CONFIGURATION
# ===============================================

# Database (Direct Connection - Rarely Needed)
# Only use if you need direct Postgres access
# POSTGRES_URL=postgres://user:password@host:5432/database
# POSTGRES_HOST=db.your-project.supabase.co
# POSTGRES_DATABASE=postgres
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_postgres_password

# Product Configuration
RATING_COLS="overall_rating,wave_quality_rating,crowd_density_rating,parking_rating,accessibility_rating"

# ===============================================
# QUICK START GUIDE
# ===============================================
# 1. Copy this file: cp .env.example .env.local
# 2. Start Supabase: supabase start
# 3. Get local keys: supabase status
# 4. Fill in NEXT_PUBLIC_SUPABASE_URL and keys
# 5. Create Firebase project (for push notifications)
# 6. Add Mapbox token (for maps)
# 7. Start dev server: yarn dev
#
# For detailed setup instructions, see:
# docs/SUPABASE_SETUP.md
# docs/SETUP.md
