# Tests (not needed for production build)
/e2e/
__tests__/

# Local dependency and build output; Vercel installs/builds these remotely.
/node_modules/
/.next/
/reports/
/.planning/
/.claude/
/.agents/
/.superpowers/
/.worktrees/

# Documentation
docs/

# Scripts (dev-only). playwright.config.ts imports load-env.mjs and is type-checked by `next build`.
scripts/*
!scripts/load-env.mjs

# Supabase config/migrations (deployed separately)
/supabase/

# Mobile native shells
ios/
android/

# IDE/tool config
.claude/
